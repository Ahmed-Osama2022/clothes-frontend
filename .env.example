# ======= API =======
# Laravel API v1 root (no trailing slash needed).
VITE_API_URL=http://api.clothes.test/api/v1
# Keep OFF while the API replies with `Access-Control-Allow-Origin: *`.
# Switch to true only when Sanctum SPA cookie auth is enabled on the backend.
VITE_API_CREDENTIALS=false

# ======= LOCALIZATION =======
VITE_DEFAULT_LOCALE=en
